{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blockdungeons.example/schema/content.v1.json",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^:]+$" },
    "properties": {
      "type": "object", "additionalProperties": {
        "type": "object", "required": ["type"],
        "properties": {
          "type": { "enum": ["int", "float", "bool", "string", "enum", "color", "ref", "vec2"] },
          "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number", "exclusiveMinimum": 0 },
          "maxLength": { "type": "integer", "minimum": 0 }, "label": { "type": "string" }, "localized": { "type": "boolean" },
          "refKind": { "enum": ["entity", "loot", "sound", "tag", "objective", "flag", "marker"] }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "enum" } } }, "then": { "required": ["values"] } },
          { "if": { "properties": { "type": { "const": "ref" } } }, "then": { "required": ["refKind"] } },
          { "if": { "properties": { "type": { "const": "int" } } }, "then": { "properties": { "default": { "type": "integer" } } } },
          { "if": { "properties": { "type": { "const": "float" } } }, "then": { "properties": { "default": { "type": "number" } } } },
          { "if": { "properties": { "type": { "const": "bool" } } }, "then": { "properties": { "default": { "type": "boolean" } } } },
          { "if": { "properties": { "type": { "enum": ["string", "enum", "ref", "color"] } } }, "then": { "properties": { "default": { "type": "string" } } } },
          { "if": { "properties": { "type": { "const": "vec2" } } }, "then": { "properties": { "default": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } } } }
        ]
      }
    },
    "render": {
      "type": "object", "properties": {
        "kind": { "enum": ["block", "model", "water", "none", "stairs", "cross"] },
        "model": { "$ref": "#/$defs/path" }, "scale": { "type": "number", "exclusiveMinimum": 0 },
        "variants": { "type": "integer", "minimum": 1 }, "topVariants": { "type": "integer", "minimum": 1 },
        "randomRotation": { "type": "boolean" }, "castsShadow": { "type": "boolean" }, "waterBelow": { "type": "boolean" }, "light": { "type": "boolean" },
        "thickness": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "animations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "weapon": {
      "type": "object", "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["melee", "ranged"] }, "projectile": { "$ref": "#/$defs/id" },
        "windupTicks": { "type": "integer", "minimum": 0 }, "recoveryTicks": { "type": "integer", "minimum": 0 }, "cooldownTicks": { "type": "integer", "minimum": 0 },
        "swings": { "type": "array", "minItems": 1, "maxItems": 16, "items": {
          "type": "object", "required": ["windupTicks", "activeTicks", "recoveryTicks", "damage", "knockback", "halfAngleDeg", "reach"],
          "properties": {
            "windupTicks": { "type": "integer", "minimum": 0 }, "activeTicks": { "type": "integer", "minimum": 1 }, "recoveryTicks": { "type": "integer", "minimum": 0 },
            "damage": { "type": "integer", "minimum": 1 }, "knockback": { "type": "number", "minimum": 0 }, "halfAngleDeg": { "type": "number", "minimum": 0, "maximum": 180 }, "reach": { "type": "number", "exclusiveMinimum": 0 }
          }
        } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "melee" } } }, "then": { "required": ["swings"] } },
        { "if": { "properties": { "kind": { "const": "ranged" } } }, "then": { "required": ["projectile", "windupTicks", "recoveryTicks", "cooldownTicks"] } }
      ]
    },
    "stats": {
      "type": "object", "properties": {
        "hp": { "type": "integer", "minimum": 1 }, "armor": { "type": "integer", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0, "maximum": 12 }, "damageMultiplier": { "type": "number", "exclusiveMinimum": 0 },
        "cooldownMultiplier": { "type": "number", "exclusiveMinimum": 0 }, "xp": { "type": "integer", "minimum": 0 },
        "knockbackResistance": { "type": "number", "minimum": 0, "maximum": 1 },
        "aggroRadius": { "type": "number", "minimum": 0 }, "hearingRadius": { "type": "number", "minimum": 0 }
      }
    },
    "projectile": { "type": "object", "properties": {
      "damage": { "type": "integer", "minimum": 1 }, "speed": { "type": "number", "exclusiveMinimum": 0 },
      "lifetimeTicks": { "type": "integer", "minimum": 1 }, "lifetime": { "type": "number", "exclusiveMinimum": 0 },
      "knockback": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 }, "pierce": { "const": 0 }
    } },
    "pickup": { "type": "object", "properties": {
      "kind": { "enum": ["emerald", "food", "arrows"] }, "amount": { "type": "integer", "minimum": 1 },
      "healFraction": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "healPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
    } },
    "entity": {
      "type": "object", "required": ["id"], "anyOf": [{ "required": ["kind"] }, { "required": ["extends"] }, { "required": ["baseDef"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "extends": { "$ref": "#/$defs/id" }, "baseDef": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["Player", "Enemy", "Projectile", "Pickup", "Prop", "Gate", "Chest", "Checkpoint", "Exit", "SpawnMarker", "Light", "Marker"] },
        "displayName": { "type": "string" }, "category": { "type": "string" }, "faction": { "enum": ["Hero", "Monster"] },
        "radius": { "type": "number", "minimum": 0, "maximum": 1 }, "solid": { "type": "boolean" }, "unique": { "type": "boolean" }, "requiresGround": { "type": "boolean" },
        "stats": { "$ref": "#/$defs/stats" }, "statMultipliers": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
        "props": { "$ref": "#/$defs/properties" }, "render": { "$ref": "#/$defs/render" },
        "weapons": { "type": "object", "properties": { "melee": { "$ref": "#/$defs/id" }, "ranged": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
        "control": { "type": "object", "properties": {
          "rollTicks": { "type": "integer", "minimum": 1 }, "rollDistance": { "type": "number", "exclusiveMinimum": 0 },
          "rollInvulnerableFirst": { "type": "integer", "minimum": 1 }, "rollInvulnerableLast": { "type": "integer", "minimum": 1 }, "rollCooldownTicks": { "type": "integer", "minimum": 0 }, "potionCooldownTicks": { "type": "integer", "minimum": 0 },
          "arrowsStart": { "type": "integer", "minimum": 0 }, "arrowsMax": { "type": "integer", "minimum": 0 }, "pickupRadius": { "type": "number", "exclusiveMinimum": 0 }, "magnetRadius": { "type": "number", "exclusiveMinimum": 0 }, "magnetSpeed": { "type": "number", "exclusiveMinimum": 0 }, "recoveryWalk": { "type": "number", "minimum": 0, "maximum": 1 }
        }, "additionalProperties": false },
        "breakable": { "type": "boolean" },
        "brain": { "$ref": "#/$defs/id" }, "loot": { "$ref": "#/$defs/id" },
        "audio": { "type": "object", "additionalProperties": { "$ref": "#/$defs/id" } },
        "attack": { "type": "object" }, "projectile": { "$ref": "#/$defs/projectile" }, "pickup": { "$ref": "#/$defs/pickup" }, "editor": { "type": "object" }
      }
    },
    "tile": {
      "type": "object", "required": ["id"], "properties": {
        "id": { "$ref": "#/$defs/id" }, "extends": { "$ref": "#/$defs/id" }, "baseFloor": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string" }, "category": { "type": "string" },
        "walkable": { "type": "boolean" }, "solid": { "type": "boolean" }, "blocksProjectiles": { "type": "boolean" }, "blocksVision": { "type": "boolean" }, "overlay": { "type": "boolean" },
        "moveCost": { "type": "number", "exclusiveMinimum": 0 }, "props": { "$ref": "#/$defs/properties" }, "render": { "$ref": "#/$defs/render" },
        "audio": { "type": "object", "additionalProperties": { "$ref": "#/$defs/id" } }, "editor": { "type": "object" }
      }
    },
    "loot": {
      "type": "object", "required": ["id", "rows"], "properties": {
        "id": { "$ref": "#/$defs/id" }, "rows": { "type": "array", "items": {
          "type": "object", "required": ["item"], "properties": {
            "item": { "enum": ["emerald", "food", "arrows"] }, "chance": { "type": "number", "minimum": 0, "maximum": 1 },
            "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 }
          }
        } }
      }
    },
    "audio": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": {
        "type": "object", "required": ["files"], "properties": {
          "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" } }, "volumeDb": { "type": "number" },
          "pitchRange": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "exclusiveMinimum": 0 } }, "maxInstances": { "type": "integer", "minimum": 1, "maximum": 16 },
          "bus": { "enum": ["Music", "SFX", "UI", "Ambience"] }, "loop": { "type": "boolean" }, "loopOffset": { "type": "number", "minimum": 0 }, "positional": { "type": "boolean" }
        }
      }
    },
    "atlas": { "type": "object", "required": ["formatVersion", "width", "height", "tileSize", "gutter", "sourceHash", "tiles"], "properties": {
      "formatVersion": { "const": 1 }, "width": { "const": 1024 }, "height": { "const": 1024 }, "tileSize": { "const": 16 }, "gutter": { "const": 2 },
      "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "tiles": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "integer", "minimum": 0, "maximum": 1024 } } }
    } },
    "device_profiles": {
      "type": "object", "additionalProperties": false, "required": ["formatVersion", "rules"],
      "properties": {
        "formatVersion": { "const": 1 },
        "rules": { "type": "array", "maxItems": 64, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "preset"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "platform": { "enum": ["any", "android", "ios", "windows", "linux", "macos"] },
            "adapter": { "type": "string", "minLength": 1, "maxLength": 128 }, "model": { "type": "string", "minLength": 1, "maxLength": 128 },
            "preset": { "enum": ["Low", "Medium", "High"] }, "renderer": { "enum": ["auto", "compatibility"] },
            "notes": { "type": "string", "maxLength": 1024 }
          },
          "allOf": [{ "if": { "required": ["renderer"], "properties": { "renderer": { "const": "compatibility" } } }, "then": { "required": ["platform"], "properties": { "platform": { "enum": ["android", "windows", "linux", "macos"] } } } }]
        } }
      }
    },
    "index": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "bootstrap": { "type": "object", "required": ["schemaVersion", "probeId", "messageKey", "rotationDegreesPerSecond"], "properties": {
      "schemaVersion": { "const": 1 }, "probeId": { "type": "string" }, "messageKey": { "type": "string" }, "rotationDegreesPerSecond": { "type": "number", "exclusiveMinimum": 0 }
    } }
  }
}
